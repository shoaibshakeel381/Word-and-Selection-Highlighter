{
    "name": "word-selection-highlighter",
    "displayName": "Word and Selection Highlighter",
    "description": "Highlights the word under the cursor and selected text, with matching occurrences shown in the editor and overview ruler.",
    "version": "0.3.0",
    "icon": "images/icon.png",
    "publisher": "ShoaibShakeel",
    "engines": {
        "vscode": "^1.16.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "configuration": {
            "title": "Word and Selection Highlighter",
            "properties": {
                "word-selection-highlighter.matchBrackets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight matching brackets with this extension."
                }
            }
        }
    },
    "main": "./out/src/extension",
    "scripts": {
        "vscode:prepublish": "node -e \"require('fs').accessSync('out/src/extension.js')\"",
        "package": "npm exec --yes --package @vscode/vsce -- vsce package --no-dependencies --allow-star-activation --allow-missing-repository"
    }
}
